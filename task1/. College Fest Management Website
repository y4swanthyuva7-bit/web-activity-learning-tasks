<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TechnoFest 2026</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #222;
    line-height: 1.6;
}

nav {
    background: #111827;
    color: white;
    padding: 15px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: #38bdf8;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 25px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

nav ul li a:hover {
    color: #38bdf8;
}

.hero {
    min-height: 500px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    padding: 50px 20px;
    background: linear-gradient(rgba(17,24,39,.75),rgba(30,41,59,.85)),
                linear-gradient(135deg,#2563eb,#7c3aed);
}

.hero h1 {
    font-size: 60px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 22px;
    margin-bottom: 25px;
}

.date {
    font-size: 18px;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 13px 28px;
    background: #38bdf8;
    color: #111827;
    text-decoration: none;
    border-radius: 30px;
    font-weight: bold;
}

.btn:hover {
    background: white;
}

section {
    padding: 70px 7%;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title h2 {
    font-size: 36px;
    color: #111827;
}

.section-title p {
    color: #64748b;
    margin-top: 8px;
}

.event-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.event-card {
    background: white;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 5px 20px rgba(0,0,0,.08);
    transition: .3s;
    border-top: 5px solid #2563eb;
}

.event-card:hover {
    transform: translateY(-8px);
}

.event-icon {
    font-size: 45px;
    margin-bottom: 15px;
}

.event-card h3 {
    color: #1e3a8a;
    margin-bottom: 10px;
}

.event-card p {
    color: #64748b;
    margin-bottom: 15px;
}

.event-info {
    font-size: 14px;
    color: #475569;
}

.technical {
    background: #eff6ff;
}

.cultural {
    background: #fff7ed;
}

.cultural .event-card {
    border-top-color: #f97316;
}

.workshops {
    background: #f0fdf4;
}

.workshops .event-card {
    border-top-color: #16a34a;
}

.schedule-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    box-shadow: 0 5px 20px rgba(0,0,0,.08);
    border-radius: 10px;
    overflow: hidden;
}

th, td {
    padding: 16px;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
}

th {
    background: #1e3a8a;
    color: white;
}

tr:hover {
    background: #f8fafc;
}

.coordinator-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 25px;
}

.coordinator {
    background: white;
    text-align: center;
    padding: 30px 20px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,.08);
}

.avatar {
    width: 90px;
    height: 90px;
    margin: auto;
    border-radius: 50%;
    background: #dbeafe;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 40px;
    margin-bottom: 15px;
}

.coordinator h3 {
    color: #1e3a8a;
}

.coordinator p {
    color: #64748b;
}

.rules {
    background: #111827;
    color: white;
}

.rules .section-title h2,
.rules .section-title p {
    color: white;
}

.rules-list {
    max-width: 850px;
    margin: auto;
    background: #1f2937;
    padding: 35px;
    border-radius: 15px;
}

.rules-list li {
    margin: 15px 0;
}

.registration {
    background: #eef2ff;
}

form {
    max-width: 750px;
    margin: auto;
    background: white;
    padding: 40px;
    border-radius: 15px;
    box-shadow: 0 5px 25px rgba(0,0,0,.08);
}

.form-group {
    margin-bottom: 20px;
}

label {
    display: block;
    font-weight: bold;
    margin-bottom: 7px;
    color: #334155;
}

input,
select,
textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 15px;
}

textarea {
    height: 120px;
    resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #2563eb;
}

.submit-btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

.submit-btn:hover {
    background: #1d4ed8;
}

.contact {
    text-align: center;
    background: #e0f2fe;
}

.contact p {
    margin: 10px;
}

footer {
    background: #0f172a;
    color: white;
    text-align: center;
    padding: 25px;
}

footer span {
    color: #38bdf8;
}

@media (max-width:1000px) {
    .event-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .coordinator-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .hero h1 {
        font-size: 48px;
    }
}

@media (max-width:700px) {
    nav {
        flex-direction: column;
        gap: 12px;
    }

    nav ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .hero {
        min-height: 450px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 18px;
    }

    .event-grid,
    .coordinator-grid {
        grid-template-columns: 1fr;
    }

    section {
        padding: 50px 5%;
    }

    .section-title h2 {
        font-size: 30px;
    }

    form {
        padding: 25px;
    }
}
</style>
</head>

